# Copy file này thành .env rồi điền giá trị thật.
# .env KHÔNG được commit (đã có trong .gitignore); .env.example thì có.

DB_HOST=localhost
DB_PORT=5932
DB_NAME=week1_rbac
DB_USER=week1_app
DB_PASSWORD=doi-thanh-mat-khau-that

# Tuỳ chọn: đặt nguyên chuỗi kết nối, sẽ được ưu tiên hơn 5 biến DB_* ở trên.
# ConnectionStrings__Default=Host=localhost;Port=5932;Database=week1_rbac;Username=week1_app;Password=...

# --- JWT ---
# Khóa ký HMAC-SHA256 phải dài tối thiểu 32 byte, ứng dụng sẽ từ chối khởi động nếu ngắn hơn.
# Sinh khóa riêng, ví dụ:  openssl rand -base64 48
Jwt__Issuer=SchoolApi
Jwt__Audience=SchoolApiClients
Jwt__SigningKey=doi-chuoi-nay-thanh-it-nhat-32-ky-tu-ngau-nhien
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

# --- Seed ---
# Mật khẩu dùng chung cho 3 tài khoản mẫu (admin/staff/sv001). Chỉ dùng trên máy lab.
Seed__Password=doi-thanh-mat-khau-lab

# --- CORS ---
# Chỉ liệt kê origin cụ thể. Không bao giờ dùng AllowAnyOrigin.
Cors__AllowedOrigins=http://localhost:5173,http://localhost:3000
